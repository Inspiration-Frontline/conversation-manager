<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="ifl.agentbreaker.conversationmanager.dao.ConversationRoundReferenceMapper">
    <resultMap id="ReferenceResultMap" type="ifl.agentbreaker.conversationmanager.domain.entities.pg.ConversationRoundReference">
        <id column="id" property="id"/>
        <result column="creator_id" property="creatorId"/>
        <result column="creation_time" property="creationTime"/>
        <result column="modifier_id" property="modifierId"/>
        <result column="modification_time" property="modificationTime"/>
        <result column="round_id" property="roundId"/>
        <result column="source_conversation_id" property="sourceConversationId"/>
        <result column="source_end_round_number" property="sourceEndRoundNumber"/>
        <result column="source_title" property="sourceTitle"/>
        <result column="reference_order" property="referenceOrder"/>
    </resultMap>

    <sql id="ReferenceColumns">
        "id", "creator_id", "creation_time", "modifier_id", "modification_time",
        "round_id", "source_conversation_id", "source_end_round_number", "source_title",
        "reference_order"
    </sql>

    <insert id="insertReferences">
        INSERT INTO "conversation_round_reference" (
            "creator_id", "modifier_id", "round_id", "source_conversation_id",
            "source_end_round_number", "source_title", "reference_order"
        ) VALUES
        <foreach collection="list" item="reference" separator=",">
            (#{reference.creatorId}, #{reference.modifierId}, #{reference.roundId},
             #{reference.sourceConversationId}, #{reference.sourceEndRoundNumber},
             #{reference.sourceTitle}, #{reference.referenceOrder})
        </foreach>
    </insert>

    <select id="listReferencesByRoundId" resultMap="ReferenceResultMap">
        SELECT <include refid="ReferenceColumns"/>
        FROM "conversation_round_reference"
        WHERE "round_id" = #{roundId}
        ORDER BY "reference_order" ASC
    </select>

    <select id="listReferencesByRoundIds" resultMap="ReferenceResultMap">
        SELECT <include refid="ReferenceColumns"/>
        FROM "conversation_round_reference"
        WHERE "round_id" IN
        <foreach collection="roundIds" item="roundId" open="(" separator="," close=")">
            #{roundId}
        </foreach>
        ORDER BY "round_id" ASC, "reference_order" ASC
    </select>

    <select id="hasReferencesInCompletedRoundsAtOrBefore" resultType="boolean">
        SELECT EXISTS (
            SELECT 1
            FROM "conversation_round_reference" reference
            INNER JOIN "conversation_round" round
              ON round."id" = reference."round_id"
            WHERE round."conversation_id" = #{conversationId}
              AND round."round_number" &lt;= #{endRoundNumber}
              AND round."status" = 'COMPLETED'
              AND round."deleted" = FALSE
        )
    </select>
</mapper>
