<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="ifl.agentbreaker.conversationmanager.dao.ConversationGroupMapper">
    <resultMap id="ConversationGroupResultMap" type="ifl.agentbreaker.conversationmanager.domain.entities.pg.ConversationGroup">
        <id column="id" property="id"/>
        <result column="creator_id" property="creatorId"/>
        <result column="creation_time" property="creationTime"/>
        <result column="modifier_id" property="modifierId"/>
        <result column="modification_time" property="modificationTime"/>
        <result column="name" property="name"/>
        <result column="description" property="description"/>
        <result column="sort_order" property="sortOrder"/>
    </resultMap>

    <resultMap id="ConversationGroupAbstractResultMap" type="ifl.agentbreaker.conversationmanager.domain.dtos.responses.ConversationGroupAbstract">
        <id column="group_id" property="groupId"/>
        <result column="name" property="name"/>
        <result column="description" property="description"/>
        <result column="sort_order" property="sortOrder"/>
        <result column="conversation_count" property="conversationCount"/>
    </resultMap>

    <sql id="ConversationGroupColumns">
        "id", "creator_id", "creation_time", "modifier_id", "modification_time",
        "name", "description", "sort_order"
    </sql>

    <insert id="insertConversationGroup" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO "conversation_group" (
            "creator_id", "modifier_id", "name", "description", "sort_order"
        )
        VALUES (
            #{creatorId}, #{modifierId}, #{name}, #{description}, #{sortOrder}
        )
    </insert>

    <select id="getConversationGroupByIdForUser" resultMap="ConversationGroupResultMap">
        SELECT <include refid="ConversationGroupColumns"/>
        FROM "conversation_group"
        WHERE "id" = #{groupId}
          AND "creator_id" = #{userId}
    </select>

    <select id="lockConversationGroupByIdForUser" resultMap="ConversationGroupResultMap">
        SELECT <include refid="ConversationGroupColumns"/>
        FROM "conversation_group"
        WHERE "id" = #{groupId}
          AND "creator_id" = #{userId}
        FOR UPDATE
    </select>

    <select id="existsByIdAndUser" resultType="boolean">
        SELECT EXISTS (
            SELECT 1
            FROM "conversation_group"
            WHERE "id" = #{groupId}
              AND "creator_id" = #{userId}
        )
    </select>

    <update id="updateConversationGroupAbstract">
        UPDATE "conversation_group"
        SET "name" = #{name},
            "description" = #{description},
            "modifier_id" = #{modifierId}
        WHERE "id" = #{id}
          AND "creator_id" = #{creatorId}
    </update>

    <delete id="deleteConversationGroup">
        DELETE FROM "conversation_group"
        WHERE "id" = #{groupId}
          AND "creator_id" = #{userId}
    </delete>

    <select id="listConversationGroups" resultMap="ConversationGroupAbstractResultMap">
        SELECT conversation_group."id" AS "group_id",
               conversation_group."name",
               conversation_group."description",
               conversation_group."sort_order",
               COUNT(conversation."id") AS "conversation_count"
        FROM "conversation_group" conversation_group
        LEFT JOIN "conversation" conversation
          ON conversation."creator_id" = conversation_group."creator_id"
         AND conversation."conversation_group_id" = conversation_group."id"
         AND conversation."deleted" = FALSE
        WHERE conversation_group."creator_id" = #{userId}
        GROUP BY conversation_group."id"
        ORDER BY conversation_group."sort_order" ASC, conversation_group."id" ASC
    </select>

    <update id="batchUpdateConversationGroupSortOrders">
        UPDATE "conversation_group" conversation_group
        SET "sort_order" = requested."sort_order",
            "modifier_id" = requested."modifier_id"
        FROM (
            VALUES
            <foreach item="group" collection="groups" separator=",">
                (#{group.id}, #{group.sortOrder}, #{group.modifierId})
            </foreach>
        ) AS requested("id", "sort_order", "modifier_id")
        WHERE conversation_group."id" = requested."id"
          AND conversation_group."creator_id" = requested."modifier_id"
    </update>

    <update id="incrementConversationGroupSortOrders">
        UPDATE "conversation_group"
        SET "sort_order" = "sort_order" + 1,
            "modifier_id" = #{userId}
        WHERE "creator_id" = #{userId}
    </update>

    <select id="listConversationGroupsForUpdate" resultMap="ConversationGroupResultMap">
        SELECT <include refid="ConversationGroupColumns"/>
        FROM "conversation_group"
        WHERE "creator_id" = #{userId}
        ORDER BY "sort_order" ASC, "id" ASC
        FOR UPDATE
    </select>

    <select id="acquireUserGroupLock" resultType="long">
        SELECT CAST(#{userId} AS BIGINT)
        FROM (SELECT pg_advisory_xact_lock(913741000000000 + #{userId})) locked
    </select>
</mapper>
